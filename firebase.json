{
  "hosting": {
    "public": "dist/scramble-roulette/browser",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "headers": [
      {
        "source": "/robots.txt",
        "headers": [
          { "key": "Content-Type", "value": "text/plain; charset=utf-8" },
          { "key": "Cache-Control", "value": "public, max-age=3600" }
        ]
      },
      {
        "source": "/sitemap.xml",
        "headers": [
          { "key": "Content-Type", "value": "application/xml; charset=utf-8" },
          { "key": "Cache-Control", "value": "public, max-age=3600" }
        ]
      }
    ],
    "redirects": [
      {
        "source": "/new-round",
        "destination": "/",
        "type": 301
      },
      {
        "source": "/dashboard",
        "destination": "/",
        "type": 301
      }
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  },
  "auth": {
    "providers": {
      "googleSignIn": {
        "oAuthBrandDisplayName": "Scramble Roulette",
        "supportEmail": "alexkopen@gmail.com",
        "authorizedRedirectUris": [
          "http://localhost",
          "https://scramble-roulette.web.app",
          "https://scramble-roulette.firebaseapp.com",
          "https://scrambleroulette.com",
          "https://www.scrambleroulette.com",
          "https://scrambleroulette.com/__/auth/handler",
          "https://www.scrambleroulette.com/__/auth/handler",
          "https://scramble-roulette.web.app/__/auth/handler"
        ]
      }
    },
    "authorizedDomains": [
      "localhost",
      "scramble-roulette.web.app",
      "scramble-roulette.firebaseapp.com",
      "scrambleroulette.com",
      "www.scrambleroulette.com"
    ]
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  }
}
