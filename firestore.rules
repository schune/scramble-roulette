rules_version = '2';

// Scramble Roulette — per-user private data, public profiles, and global feed.
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isFollowerOf(uid) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(uid)/followers/$(request.auth.uid));
    }

    function feedLiveActivityIso(data) {
      return data.updatedAt is string ? data.updatedAt : data.startedAt;
    }

    function isWeekOldIso(iso) {
      return iso is string
        && iso.size() >= 19
        && request.time > timestamp.date(
             int(iso[0:4]), int(iso[5:7]), int(iso[8:10]),
             int(iso[11:13]), int(iso[14:16]), int(iso[17:19])
           ) + duration.value(7, 'd');
    }

    function isWeekOldFeedLive(data) {
      return isWeekOldIso(feedLiveActivityIso(data));
    }

    function isOnFinalHole(data) {
      return data.currentHole is int
        && data.holeCount is int
        && data.currentHole >= data.holeCount;
    }

    function isRepublishFromStaleLive(data) {
      let uid = data.userId;
      let livePath = /databases/$(database)/documents/feedLive/$(uid);
      return exists(livePath)
        && get(livePath).data.roundId == data.roundId
        && isWeekOldFeedLive(get(livePath).data)
        && isOnFinalHole(get(livePath).data);
    }

    // Searchable public profile slice (no private email, etc.).
    match /publicProfiles/{uid} {
      allow read: if isSignedIn();
      allow create, update: if isOwner(uid);
      allow delete: if isOwner(uid);
    }

    // Global live rounds feed — readable by any signed-in player.
    match /feedLive/{uid} {
      allow read: if isSignedIn();
      allow create, update: if isOwner(uid);
      allow delete: if isOwner(uid) || (isSignedIn() && isWeekOldFeedLive(resource.data));
    }

    // Posted scorecards — readable by any signed-in player.
    match /feedPosts/{postId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && (
        request.resource.data.userId == request.auth.uid
        || isRepublishFromStaleLive(request.resource.data)
      );
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    match /users/{uid} {
      allow read, write: if isOwner(uid);

      match /rounds/{roundId} {
        allow read, write: if isOwner(uid);
      }

      // Who this user follows (private to the owner).
      match /following/{followeeId} {
        allow read, write: if isOwner(uid);
      }

      // Who follows this user — followers may create/delete their own edge.
      match /followers/{followerId} {
        allow read: if isOwner(uid) || (isSignedIn() && request.auth.uid == followerId);
        allow create, delete: if isSignedIn() && request.auth.uid == followerId;
      }

      // Legacy live scoreboard (followers-only); kept for backward compatibility.
      match /liveRound/{docId} {
        allow read: if isOwner(uid) || isFollowerOf(uid);
        allow write: if isOwner(uid);
      }
    }
  }
}
